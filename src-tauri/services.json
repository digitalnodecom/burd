          "key": "php_memory_limit",
          "label": "Memory Limit",
          "type": "text",
          "required": false,
          "default": "256M",
          "description": "PHP memory_limit setting for all parked sites"
        },
        {
          "key": "php_upload_max_filesize",
          "label": "Upload Max Size",
          "type": "text",
          "required": false,
          "default": "64M",
          "description": "PHP upload_max_filesize setting"
        },
        {
          "key": "php_post_max_size",
          "label": "Post Max Size",
          "type": "text",
          "required": false,
          "default": "64M",
          "description": "PHP post_max_size setting"
        },
        {
          "key": "php_max_execution_time",
          "label": "Max Execution Time",
          "type": "text",
          "required": false,
          "default": "30",
          "description": "PHP max_execution_time in seconds"
        }
      ],
      "start_args": [
        "run",
        "--config",
        "{config_file}"
      ],
      "env_vars": [
        {
          "name": "PHP_MEMORY_LIMIT",
          "value": "{php_memory_limit}"
