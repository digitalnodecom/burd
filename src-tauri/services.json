{
  "services": {
    "meilisearch": {
      "display_name": "Meilisearch",
      "binary_name": "meilisearch",
      "default_port": 7700,
      "auto_create_domain": true,
      "health_check": {
        "type": "http",
        "path": "/health"
      },
      "config_fields": [
        {
          "key": "master_key",
          "label": "Master Key",
          "type": "password",
          "required": false
        }
      ],
      "start_args": [
        "--db-path",
        "{data_dir}",
        "--http-addr",
        "127.0.0.1:{port}",
        "--env",
        "development"
      ],
      "start_args_conditional": [
        {
          "if_config": "master_key",
          "args": [
            "--master-key",
            "{master_key}"
          ]
        }
      ],
      "versions": {
        "source": "github_releases",
        "github_repo": "meilisearch/meilisearch"
      },
      "platforms": {
        "darwin-arm64": {
          "download": {
            "type": "github_asset",
            "asset_pattern": "meilisearch-macos-apple-silicon"
          },
          "is_archive": false
        },
        "darwin-x64": {
          "download": {
            "type": "github_asset",
            "asset_pattern": "meilisearch-macos-amd64"
          },
          "is_archive": false
        },
        "linux-x64": {
          "download": {
            "type": "github_asset",
            "asset_pattern": "meilisearch-linux-amd64"
          },
          "is_archive": false
        },
        "windows-x64": {
          "download": {
            "type": "github_asset",
            "asset_pattern": "meilisearch-windows-amd64.exe"
          },
          "is_archive": false,
          "binary_name": "meilisearch.exe"
        }
      }
    },
    "typesense": {
      "display_name": "Typesense",
      "binary_name": "typesense-server",
      "default_port": 8108,
      "auto_create_domain": true,
      "health_check": {
        "type": "http",
        "path": "/health"
      },
      "config_fields": [
        {
          "key": "api_key",
          "label": "API Key",
          "type": "password",
          "required": false,
          "default": "xyz"
        }
      ],
      "start_args": [
        "--data-dir",
        "{data_dir}",
        "--api-port",
        "{port}",
        "--enable-cors",
        "--api-key",
        "{api_key}"
      ],
      "versions": {
        "source": "github_releases",
        "github_repo": "typesense/typesense"
      },
      "platforms": {
        "darwin-arm64": {
          "download": {
            "type": "direct",
            "url_template": "https://dl.typesense.org/releases/{version}/typesense-server-{version}-darwin-arm64.tar.gz"
          },
          "is_archive": true
        },
        "darwin-x64": {
          "download": {
            "type": "direct",
            "url_template": "https://dl.typesense.org/releases/{version}/typesense-server-{version}-darwin-amd64.tar.gz"
          },
          "is_archive": true
        },
        "linux-x64": {
          "download": {
            "type": "direct",
            "url_template": "https://dl.typesense.org/releases/{version}/typesense-server-{version}-linux-amd64.tar.gz"
          },
          "is_archive": true
        }
      }
    },
    "mongodb": {
      "display_name": "MongoDB",
      "binary_name": "mongod",
      "default_port": 27017,
      "auto_create_domain": false,
      "health_check": {
        "type": "tcp"
      },
      "config_fields": [],
      "start_args": [
        "--dbpath",
        "{data_dir}",
        "--port",
        "{port}",
        "--bind_ip",
        "127.0.0.1"
      ],
      "versions": {
        "source": "static",
        "versions": [
          "8.0.4",
          "8.0.3",
          "7.0.15",
          "7.0.14",
          "6.0.19",
          "6.0.18"
        ]
      },
      "platforms": {
        "darwin-arm64": {
          "download": {
            "type": "direct",
            "url_template": "https://fastdl.mongodb.org/osx/mongodb-macos-arm64-{version}.tgz"
          },
          "is_archive": true
        },
        "darwin-x64": {
          "download": {
            "type": "direct",
            "url_template": "https://fastdl.mongodb.org/osx/mongodb-macos-x86_64-{version}.tgz"
          },
          "is_archive": true
        },
        "linux-x64": {
          "download": {
            "type": "direct",
            "url_template": "https://fastdl.mongodb.org/linux/mongodb-linux-x86_64-ubuntu2204-{version}.tgz"
          },
          "is_archive": true
        },
        "windows-x64": {
          "download": {
