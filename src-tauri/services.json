    "minio": {
      "display_name": "MinIO",
      "binary_name": "minio",
      "default_port": 9000,
      "auto_create_domain": true,
      "health_check": {
        "type": "http",
        "path": "/minio/health/live"
      },
      "config_fields": [
        {
          "key": "root_user",
          "label": "Root User",
          "type": "text",
          "required": false,
          "default": "minioadmin"
        },
        {
          "key": "root_password",
          "label": "Root Password",
          "type": "password",
          "required": false,
          "default": "minioadmin"
        }
      ],
      "start_args": [
        "server",
        "{data_dir}",
        "--address",
        "127.0.0.1:{port}",
        "--console-address",
        "127.0.0.1:{console_port}"
      ],
      "env_vars": [
        {
          "name": "MINIO_ROOT_USER",
          "value": "{root_user}"
        },
        {
          "name": "MINIO_ROOT_PASSWORD",
          "value": "{root_password}"
        }
      ],
      "computed_values": {
        "console_port": "{port} + 1"
