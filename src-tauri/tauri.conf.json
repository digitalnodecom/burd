{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burd",
  "version": "1.11.5",
  "identifier": "com.burd.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "mainBinaryName": "burd-app",
  "app": {
    "windows": [
      {
        "title": "Burd",
        "width": 1100,
        "height": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mkcert"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/digitalnodecom/burd/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRTU4RUZDODhBMTExQjgKUldTNEVhR0kvSTdsVzdKZDFWQ2w1NjRrdXkvb1pjblZRaEVTck9qVjdMYlZjL0pqSFlBK21jT24K"
    }
  }
}
